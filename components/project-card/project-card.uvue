<template>
  <view class="project-card" @click="goDetail">
    <view class="project-cover-wrap">
      <image class="project-cover" :src="project.cover" mode="aspectFit" />
    </view>

    <view class="project-body">
      <view class="project-title-row">
        <text class="project-title">{{ project.title }}</text>
        <view class="status-badge">
          <text class="status-badge-text">{{ project.status }}</text>
        </view>
      </view>

      <text class="project-intro">{{ shortIntro }}</text>

      <view class="project-tags">
        <view
          v-for="tag in project.tags"
          :key="tag"
          class="project-tag"
        >
          <text class="project-tag-text">{{ tag }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: {
    project: {
      type: Object,
      required: true
    }
  },
  computed: {
    shortIntro(): string {
      const text = this.project.intro as string
      if (text.length > 44) {
        return text.substring(0, 44) + '...'
      }
      return text
    }
  },
  methods: {
    goDetail() {
      uni.navigateTo({
        url: '/pages/project/detail?projectId=' + this.project.id
      })
    }
  }
}
</script>

