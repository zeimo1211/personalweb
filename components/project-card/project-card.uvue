  width: 100%;
  background-color: #ffffff;
  border-width: 1px;
  border-style: solid;
  border-color: #e5e7eb;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(17, 24, 39, 0.05);
}

