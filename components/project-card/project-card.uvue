}

.project-intro {
  margin-top: 10px;
  font-size: 14px;
  line-height: 22px;
  color: #4b5563;
  min-height: 44px;
}

.project-meta-row {
  margin-top: 12px;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.project-meta-text {
  font-size: 12px;
