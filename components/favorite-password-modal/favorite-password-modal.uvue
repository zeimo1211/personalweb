<template>
	<view class="password-backdrop">
		<view class="password-dialog" @click.stop>
			<view class="password-mark">
				<view class="password-mark-core"></view>
			</view>
			<text class="password-kicker">PRIVATE AREA</text>
			<text class="password-title">进入我的最爱</text>
			<text class="password-desc">这里需要一句只有你知道的话。</text>

			<input class="password-input" :class="status == 'error' ? 'password-input-error' : ''"
				:value="password" placeholder="请输入密码" @input="onInput" @confirm="submit" />

			<text v-if="message != ''" class="password-message" :class="status == 'success' ? 'password-message-success' : 'password-message-error'">
				{{ message }}
			</text>

			<view class="password-actions">
				<view class="password-btn password-btn-secondary" @click="cancel">
					<text class="password-btn-secondary-text">取消</text>
				</view>
				<view class="password-btn password-btn-primary" @click="submit">
					<text class="password-btn-primary-text">确认进入</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		emits: ['verified', 'cancel'],
		data() {
			return {
				password: '',
				message: '',
				status: ''
			}
		},
		methods: {
			onInput(event : any) {
				this.password = String(event.detail.value || '')
				if (this.status == 'error') {
					this.message = ''
					this.status = ''
				}
			},
			submit() {
				if (this.password == '我什么都做不到！') {
					this.status = 'success'
					this.message = '密码正确'
					setTimeout(() => {
						this.$emit('verified')
					}, 650)
				} else {
					this.status = 'error'
					this.message = this.password == '' ? '请输入密码' : '密码错误'
				}
			},
			cancel() {
				this.$emit('cancel')
			}
		}
	}
</script>

<style>
	.password-backdrop {
		position: fixed;
		inset: 0;
		z-index: 80;
		background-color: rgba(18, 35, 32, 0.34);
		backdrop-filter: blur(4px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 18px;
		box-sizing: border-box;
	}

	.password-dialog {
		width: 360px;
		max-width: 100%;
		padding: 24px;
		border-width: 1px;
		border-style: solid;
		border-color: #b9d3cb;
		border-top-width: 4px;
		border-top-color: #dca2a3;
		border-radius: 8px;
		background-color: #fffdf7;
		box-shadow: 7px 8px 0 rgba(103, 138, 128, 0.16), 0 24px 58px rgba(15, 32, 29, 0.24);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.password-mark {
		width: 34px;
		height: 34px;
		border-width: 2px;
		border-style: solid;
		border-color: #c97980;
		background-color: #f3c1b5;
		transform: rotate(45deg);
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: center;
	}

	.password-mark-core {
		width: 12px;
		height: 12px;
		background-color: #fffaf0;
	}

	.password-kicker {
		margin-top: 18px;
		font-size: 12px;
		line-height: 18px;
		color: #2f8077;
		font-weight: 800;
		text-align: center;
	}

	.password-title {
		margin-top: 6px;
		font-size: 24px;
		line-height: 32px;
		color: #243a36;
		font-weight: 800;
		text-align: center;
	}

	.password-desc {
		margin-top: 8px;
		font-size: 14px;
		line-height: 22px;
		color: #788985;
		text-align: center;
	}

	.password-input {
		margin-top: 18px;
		width: 100%;
		height: 44px;
		padding-left: 14px;
		padding-right: 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #bdcbc5;
		border-radius: 6px;
		background-color: #f8fbf7;
		color: #243a36;
		font-size: 15px;
		box-sizing: border-box;
	}

	.password-input-error {
		border-color: #dca2a3;
		background-color: #fff7f4;
	}

	.password-message {
		margin-top: 10px;
		font-size: 13px;
		line-height: 20px;
		font-weight: 700;
		text-align: center;
	}

	.password-message-success {
		color: #2f8077;
	}

	.password-message-error {
		color: #b95d63;
	}

	.password-actions {
		margin-top: 18px;
		display: flex;
		flex-direction: row;
		gap: 10px;
	}

	.password-btn {
		flex: 1;
		height: 40px;
		border-radius: 6px;
		border-width: 1px;
		border-style: solid;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.password-btn-secondary {
		background-color: #fffdf7;
		border-color: #bdcbc5;
	}

	.password-btn-primary {
		background-color: #2f8077;
		border-color: #236b63;
		box-shadow: 3px 3px 0 rgba(32, 92, 84, 0.18);
	}

	.password-btn-secondary-text,
	.password-btn-primary-text {
		font-size: 14px;
		font-weight: 700;
	}

	.password-btn-secondary-text {
		color: #5d6d69;
