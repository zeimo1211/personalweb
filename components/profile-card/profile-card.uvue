<template>
  <view class="profile-card">
    <view class="profile-top" @click="goHome">
      <image class="avatar" :src="profile.avatar" mode="aspectFill" />
      <view class="profile-info">
        <text class="profile-label">我是</text>
        <text class="profile-name">{{ profile.nickname }}</text>
      </view>
    </view>

    <text class="profile-intro">{{ profile.intro }}</text>

    <view class="bilibili-link" @click="goBilibili">
      <text class="bilibili-link-text">前往 Bilibili 主页</text>
    </view>
  </view>
</template>

<script lang="uts">
import { openExternalUrl } from '@/utils/site.uts'

export default {
  props: {
    profile: {
      type: Object,
      required: true
    }
  },
  methods: {
    goBilibili() {
      openExternalUrl(this.profile.bilibili as string)
    },
	goHome() {
	  uni.reLaunch({
	    url: '/pages/home/index'
	  })
	}
  }
}
</script>

