<template>
	<view class="section-nav">
		<view class="nav-header">
			<text class="nav-header-title">导航</text>
			<text class="nav-header-desc">快速前往不同页面</text>
		</view>

		<view class="nav-group">
			<view v-for="section in sections" :key="section.id" class="nav-btn"
				:class="activeSectionId == section.id ? 'nav-btn-active' : ''" @click="goSection(section.id)">
				<view class="nav-indicator" :class="activeSectionId == section.id ? 'nav-indicator-active' : ''"></view>

				<view class="nav-main">
					<text class="nav-btn-text" :class="activeSectionId == section.id ? 'nav-btn-text-active' : ''">
						{{ section.name }}
					</text>
				</view>
			</view>

			<view class="nav-btn" :class="activeSectionId == 'games' ? 'nav-btn-active' : ''" @click="goGames">
				<view class="nav-indicator" :class="activeSectionId == 'games' ? 'nav-indicator-active' : ''"></view>
				<view class="nav-main">
					<text class="nav-btn-text" :class="activeSectionId == 'games' ? 'nav-btn-text-active' : ''">
						游戏经历
					</text>
				</view>
			</view>

			<view class="nav-btn" :class="activeSectionId == 'digital' ? 'nav-btn-active' : ''" @click="goDigitalDIY">
				<view class="nav-indicator" :class="activeSectionId == 'digital' ? 'nav-indicator-active' : ''"></view>
				<view class="nav-main">
					<text class="nav-btn-text" :class="activeSectionId == 'digital' ? 'nav-btn-text-active' : ''">
						数码DIY
					</text>
				</view>
			</view>

			<view class="nav-btn" :class="activeSectionId == 'favorite' ? 'nav-btn-active' : ''" @click="goFavorite">
				<view class="nav-indicator" :class="activeSectionId == 'favorite' ? 'nav-indicator-active' : ''"></view>
				<view class="nav-main">
					<text class="nav-btn-text" :class="activeSectionId == 'favorite' ? 'nav-btn-text-active' : ''">
						我的最爱
					</text>
				</view>
			</view>

			<view class="nav-btn" :class="activeSectionId == 'about' ? 'nav-btn-active' : ''" @click="goAbout">
				<view class="nav-indicator" :class="activeSectionId == 'about' ? 'nav-indicator-active' : ''"></view>
				<view class="nav-main">
					<text class="nav-btn-text" :class="activeSectionId == 'about' ? 'nav-btn-text-active' : ''">
						关于
					</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		props: {
			sections: {
				type: Array,
				required: true
			},
			activeSectionId: {
				type: String,
				default: ''
			}
		},
		methods: {
			goSection(sectionId : string) {
				uni.navigateTo({
					url: '/pages/section/index?sectionId=' + sectionId
				})
			},
			goGames() {
				uni.navigateTo({
					url: '/pages/games/index'
				})
			},
			goDigitalDIY() {
				uni.navigateTo({
					url: '/pages/digital/index'
				})
			},
			goFavorite() {
				uni.navigateTo({
					url: '/pages/favorite/index'
				})
			},
			goAbout() {
				uni.navigateTo({
					url: '/pages/about/index'
				})
			}
		}
	}
</script>

