import { reactive } from 'vue'

export type Profile = {
	nickname : string
	QQ : string
	avatar : string
	bilibili : string
	intro : string
	steamID : string
	genshinID : string
	honkai3ID : string
	starrailID : string
}

export type GameExperience = {
	id : string
	title : string
	cover : string
	tags : string[]
	duration : string
	progress : string
	score : string
	review : string
}

export type FavoriteStage = {
	id : string
	title : string
	subtitle : string
	image : string
	desc : string
	note : string
}

export type FavoriteReason = {
	id : string
	title : string
	desc : string
}

export type FavoriteGalleryItem = {
	id : string
	image : string
	caption : string
}

export type FavoriteCharacter = {
	name : string
	enName : string
	heroImage : string
	slogan : string
	intro : string
	ending : string
	stages : FavoriteStage[]
	reasons : FavoriteReason[]
	gallery : FavoriteGalleryItem[]
}

export type Project = {
	id : string
	title : string
	cover : string
	gallery : string[]
	officialGuid : string
	bilibiliGuid : string
	playerCount : string
	type : string
	devices : string[]
	status : string
	tags : string[]
	intro : string
	gameplay : string[]
}

export type DigitalItem = {
	id : string
	title : string
	cover : string
	category : string
	status : string
	score : string
	spec : string
	review : string
}

export type Section = {
	id : string
	name : string
	desc : string
	projects : Project[]
}

export type SiteData = {
	profile : Profile
	sections : Section[]
	games : GameExperience[]
	digitalDIY : DigitalItem[]
	favorite : FavoriteCharacter
}

