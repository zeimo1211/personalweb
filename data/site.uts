function isArrayData(data: any): boolean {
	return Array.isArray(data)
}

function loadSections() {
	uni.request({
		url: '/static/data/sections.json',
		method: 'GET',
		success: (res) => {
			const data = res.data
			if (isArrayData(data)) {
				siteData.sections = data as Section[]
			} else {
				console.error('sections.json 返回的不是数组：', data)
			}
		},
		fail: (err) => {
			console.error('sections.json 加载失败：', err)
		}
	})
}

function loadGames() {
	uni.request({
		url: '/static/data/games.json',
		method: 'GET',
		success: (res) => {
			const data = res.data
			if (isArrayData(data)) {
				siteData.games = data as GameExperience[]
			} else {
				console.error('games.json 返回的不是数组：', data)
			}
		},
		fail: (err) => {
			console.error('games.json 加载失败：', err)
		}
	})
}

function loadDigitalDIY() {
	uni.request({
		url: '/static/data/digital-diy.json',
		method: 'GET',
		success: (res) => {
			const data = res.data
			if (isArrayData(data)) {
				siteData.digitalDIY = data as DigitalItem[]
				console.debug(data)
			} else {
				console.error('games.json 返回的不是数组：', data)
			}
		},
		fail: (err) => {
			console.error('games.json 加载失败：', err)
		}
	})
}

// 模块加载时自动读取
loadSections()
loadGames()
loadDigitalDIY()
