  data() {
    return {
      site: siteData
    }
  },
  methods: {
    copyText(value: string) {
      uni.setClipboardData({
        data: value,
        success: () => {
          uni.showToast({
            title: '已复制',
            icon: 'none'
          })
        }
      })
    }
  }
}
