<template>
	<view class="home-page">
		<view id="cube-world" class="cube-world">
			<view class="loading-panel">
				<text class="loading-kicker">PERSONAL SPACE</text>
				<text class="loading-title">正在建立三维空间</text>
				<text class="loading-text">加载场景与控制系统...</text>
			</view>
		</view>

		<site-menu :profile="site.profile" :sections="site.sections" activeSectionId="" />
	</view>
</template>

<script lang="uts">
	import { siteData } from '@/data/site.uts'
	import SiteMenu from '@/components/site-menu/site-menu.uvue'

	export default {
		components: {
			SiteMenu
		},
		data() {
			return {
				site: siteData
			}
		},
		mounted() {
			// #ifdef WEB
			this.loadWorldScript('/static/vendor/three.min.js', 'three-runtime', () => {
				this.loadWorldScript('/static/cube-world.js?v=20260804-joystick', 'cube-world-runtime-joystick', () => {
					const runtime = (window as any).PersonalCubeWorld
					const host = document.getElementById('cube-world')
					if (runtime != null && host != null) {
						runtime.mount(host)
					}
				})
			})
			// #endif
		},
		beforeUnmount() {
			// #ifdef WEB
			const runtime = (window as any).PersonalCubeWorld
			if (runtime != null) runtime.destroy()
			// #endif
		},
		methods: {
			loadWorldScript(src : string, id : string, done : () => void) {
				// #ifdef WEB
				const existing = document.getElementById(id) as HTMLScriptElement | null
				if (existing != null) {
					if (existing.dataset.loaded == 'true') done()
					else existing.addEventListener('load', done, { once: true })
					return
				}

				const script = document.createElement('script') as HTMLScriptElement
				script.id = id
				script.src = src
				script.async = true
				script.addEventListener('load', () => {
					script.dataset.loaded = 'true'
					done()
				}, { once: true })
				document.head.appendChild(script)
				// #endif
			}
		}
	}
</script>

<style>
	.home-page,
	.cube-world {
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
		background-color: #bfdad8;
	}

	.home-page {
		position: relative;
	}

	.cube-world {
		position: relative;
	}

	.loading-panel {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 280px;
		transform: translate(-50%, -50%);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.loading-kicker {
		font-size: 12px;
		font-weight: 800;
		color: #176b61;
		letter-spacing: 1px;
	}

	.loading-title {
		margin-top: 10px;
		font-size: 24px;
		font-weight: 800;
		color: #10201d;
	}

	.loading-text {
		margin-top: 8px;
		font-size: 13px;
		color: #5d6d69;
	}

</style>
