/* 背景层 */
.page-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/*
  核心逻辑：
  1. 高度始终撑满容器
  2. 宽度按比例自动扩展
  3. 最小宽度至少 100%，避免宽屏时露底
  4. 窗口变窄时会优先保高度，多余宽度被裁掉
*/
.page-bg-image {
  position: absolute;
  top: 0%;
  left: 50%;
  height: 100%;
  width: auto;
  min-width: 100%;
  transform: translateX(-50%);
}

/*
  -50% 表示严格居中
  -42% 表示稍微向左露出更多右侧内容，
  也就是“优先隐藏图片左侧”
  你可以改成：
  -45% / -40% / -35%
  数值越大（越接近 0），左侧裁得越多
*/

.page-bg-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
