<template>
  <view class="page">
    <!-- 背景图层 -->
    <view class="page-bg">
      <image
        class="page-bg-image"
        src="/static/image/home-kiana.webp"
        mode="aspectFill"
      />
      <view class="page-bg-mask"></view>
    </view>

    <site-sidebar
      :profile="site.profile"
      :sections="site.sections"
      activeSectionId=""
    />

    <scroll-view class="content" scroll-y="true">
      <view class="hero-card">
        <text class="hero-kicker">PERSONAL SITE</text>
        <text class="hero-title">无边的奇想角落</text>
        <text class="hero-slogan">
          记录突然的想法与一些慢慢生长出来的奇域。
        </text>

        <view class="hero-divider"></view>

        <view class="hero-info-list">
          <view class="hero-info-item">
            <text class="hero-info-label">正在做的事</text>
            <text class="hero-info-value">学业 / 奇域制作</text>
          </view>

          <view class="hero-info-item">
            <text class="hero-info-label">内容方向</text>
            <text class="hero-info-value">计算机 / AI / 探索解谜、关卡设计</text>
          </view>

          <view class="hero-info-item">
            <text class="hero-info-label">一句话介绍</text>
            <text class="hero-info-value">为世界上所有的美好而战！</text>
          </view>
        </view>
      </view>

      <view class="recommend-wrap">
        <view class="section-head">
          <view>
            <text class="section-subtitle">推荐分区</text>
            <text class="section-title">从这里进入我的奇域</text>
          </view>
        </view>

        <view
          v-if="firstSection"
          class="section-entry-card"
          @click="goFirstSection"
        >
          <view class="section-entry-main">
            <text class="section-entry-name">{{ firstSection.name }}</text>
            <text class="section-entry-desc">{{ firstSection.desc }}</text>

            <view class="section-entry-meta">
              <view class="section-entry-badge">
                <text class="section-entry-badge-text">
                  {{ firstSection.projects.length }} 个奇域
                </text>
              </view>

              <view class="section-entry-action">
                <text class="section-entry-action-text">进入分区</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { siteData } from '@/data/site.uts'
import SiteSidebar from '@/components/site-sidebar/site-sidebar.uvue'

export default {
  components: {
    SiteSidebar
  },
  data() {
    return {
      site: siteData
    }
  },
  computed: {
    firstSection() {
      return this.site.sections.length > 0 ? this.site.sections[0] : null
    }
  },
  methods: {
    goFirstSection() {
      if (!this.firstSection) return

      uni.navigateTo({
        url: '/pages/section/index?sectionId=' + this.firstSection.id
      })
    }
  }
}
</script>

<style>
