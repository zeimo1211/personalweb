<template>
  <view class="page" v-if="section != null">
    <site-sidebar
      :profile="site.profile"
      :sections="site.sections"
      :activeSectionId="section.id"
    />

    <scroll-view class="content" scroll-y="true">
      <view class="section-banner">
        <view class="section-banner-main">
          <text class="section-subtitle">奇域列表</text>
          <text class="section-title">{{ section.name }}</text>
          <text class="section-desc">{{ section.desc }}</text>
        </view>

        <view class="section-badge">
          <text class="section-badge-text">{{ section.projects.length }} 个奇域</text>
        </view>
      </view>

      <view class="cards-grid">
        <view
          v-for="item in section.projects"
          :key="item.id"
          class="card-cell"
        >
          <project-card :project="item" />
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="page" v-else>
    <site-sidebar
      :profile="site.profile"
      :sections="site.sections"
      activeSectionId=""
    />

    <view class="content empty-wrap">
      <text class="empty-title">未找到该分区</text>
      <view class="primary-btn" @click="goHome">
        <text class="primary-btn-text">返回首页</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { siteData } from '@/data/site.uts'
import { getSectionById } from '@/utils/site.uts'
import SiteSidebar from '@/components/site-sidebar/site-sidebar.uvue'
import ProjectCard from '@/components/project-card/project-card.uvue'

export default {
  components: {
    SiteSidebar,
    ProjectCard
  },
  data() {
    return {
      site: siteData,
      section: null as any
    }
  },
  onLoad(options) {
    const sectionId = options?.sectionId || ''
    this.section = getSectionById(sectionId)
  },
  methods: {
    goHome() {
      uni.reLaunch({
        url: '/pages/home/index'
      })
    }
  }
}
</script>

