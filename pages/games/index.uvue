<template>
	<view class="page">
		<site-menu :profile="site.profile" :sections="site.sections" activeSectionId="games" />

		<scroll-view class="content" scroll-y="true" :scroll-top="scrollTopValue" scroll-with-animation="true"
			lower-threshold="120" @scrolltolower="handleScrollToLower" @scroll="handleScroll">
			<view class="hero-card">
				<text class="hero-subtitle">游戏经历</text>
				<text class="hero-title">我玩过的游戏</text>
				<text class="hero-desc">
					这里记录我体验过的一些游戏，以及它们带给我的感受、节奏和设计印象。
				</text>

				<view class="toolbar">
					<view class="tag-filter">
						<text class="tag-filter-label">标签筛选</text>
						<view class="tag-select-wrap">
							<view class="tag-select-trigger" @click="toggleTagOptions">
								<view class="selected-tag-pill" :class="{ 'selected-tag-pill-muted': selectedTag == '' }">
									<text class="selected-tag-pill-text">{{ selectedTagLabel }}</text>
								</view>
								<text class="tag-select-arrow">{{ tagOptionsOpen ? '⌃' : '⌄' }}</text>
							</view>
							<view v-if="tagOptionsOpen" class="tag-options">
								<view v-for="tag in tagOptions" :key="tag" class="tag-option"
									:class="{ 'tag-option-active': selectedTag == tag }" @click="selectTag(tag)">
									<text class="tag-option-text">{{ tag }}</text>
									<text v-if="selectedTag == tag" class="tag-option-check">✓</text>
								</view>
								<view v-if="selectedTag != ''" class="tag-option-clear" @click="clearTagSelection">
									<text class="tag-option-clear-text">清除标签筛选</text>
								</view>
							</view>
						</view>
					</view>
					<view class="search-box">
						<input class="search-input" :value="searchKeyword" placeholder="搜索游戏名称 / 时长 / 进度 / 评价"
							@input="onSearchInput" />
					</view>

					<view v-if="searchKeyword != '' || selectedTag != ''" class="clear-btn" @click="clearFilters">
						<text class="clear-btn-text">清空筛选</text>
					</view>

					<view class="result-badge">
						<text class="result-badge-text">共 {{ filteredGames.length }} 项</text>
					</view>
				</view>
			</view>

			<view v-if="visibleGames.length > 0" class="games-list">
				<view v-for="game in visibleGames" :key="game.id" class="game-card">
					<view class="game-cover-wrap">
						<image class="game-cover" :src="game.cover" mode="aspectFit" />
					</view>

					<view class="game-main">
						<view class="game-header">
							<text class="game-title">{{ game.title }}</text>
							<view class="game-header-right">
								<view v-if="game.tags && game.tags.length > 0" class="game-tags">
									<view v-for="tag in game.tags" :key="tag" class="game-tag">
										<text class="game-tag-text">{{ tag }}</text>
									</view>
								</view>
								<view class="game-score-badge">
									<text class="game-score-text">{{ game.score }}</text>
								</view>
							</view>
						</view>

						<view class="game-meta-grid">
							<view class="game-meta-item">
								<text class="game-meta-label">游戏时长</text>
								<text class="game-meta-value">{{ game.duration }}</text>
							</view>

							<view class="game-meta-item">
								<text class="game-meta-label">游戏进度</text>
								<text class="game-meta-value">{{ game.progress }}</text>
							</view>
						</view>

						<view class="game-review-block">
							<text class="game-review-label">评价</text>
							<text class="game-review-text">{{ game.review }}</text>
						</view>
					</view>
				</view>
			</view>

			<view v-else class="empty-wrap">
				<text class="empty-text">没有找到匹配的游戏。</text>
			</view>

			<view v-if="canLoadMore" class="load-tip-wrap">
				<text class="load-tip-text">继续下滑以加载更多</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>

		<view v-if="showBackTop" class="back-top-btn" @click="backToTop">
			<text class="back-top-btn-text">回到顶部</text>
		</view>
	</view>
</template>

<script lang="uts">
	import { siteData } from '@/data/site.uts'
	import SiteMenu from '@/components/site-menu/site-menu.uvue'

	export default {
		components: {
			SiteMenu
		},
		data() {
			return {
				site: siteData,
				searchKeyword: '',
				selectedTag: '',
				tagOptions: [
					'二次元', '互动电影', '休闲', '剧情', '动作', '单机', '卡牌', '合作', '回合制', '射击',
					'平台跳跃', '建造', '开放世界', '恐怖', '手游', '换装', '收集养成', '模拟经营', '独立游戏',
					'生存', '科幻', '竞速', '策略', '类银河战士恶魔城', '经典', '角色扮演', '解谜', '长线运营', '音游'
				],
				tagOptionsOpen: false,
				displayCount: 8,
				pageSize: 8,
				scrollTopValue: 0,
				showBackTop: false
			}
		},
		computed: {
			selectedTagLabel() : string {
				if (this.selectedTag == '') {
					return '全部标签'
				}
				return this.selectedTag
			},
			filteredGames() : any[] {
				const keyword = this.searchKeyword.trim().toLowerCase()
				const list = this.site.games as any[]

				return list.filter((item) => {
					const tags = item.tags || []
					if (this.selectedTag != '' && tags.indexOf(this.selectedTag) == -1) {
						return false
					}
					if (keyword == '') {
						return true
					}
					const title = String(item.title || '').toLowerCase()
					const duration = String(item.duration || '').toLowerCase()
					const progress = String(item.progress || '').toLowerCase()
					const score = String(item.score || '').toLowerCase()
					const review = String(item.review || '').toLowerCase()

					return (
						title.indexOf(keyword) > -1 ||
						duration.indexOf(keyword) > -1 ||
						progress.indexOf(keyword) > -1 ||
						score.indexOf(keyword) > -1 ||
						review.indexOf(keyword) > -1
					)
				})
			},
			visibleGames() : any[] {
				return this.filteredGames.slice(0, this.displayCount)
			},
			canLoadMore() : boolean {
				return this.displayCount < this.filteredGames.length
			}
		},
		methods: {
			onSearchInput(event : any) {
				this.searchKeyword = String(event.detail.value || '')
				this.displayCount = this.pageSize
				this.showBackTop = false
				this.backToTop()
			},
			clearSearch() {
				this.searchKeyword = ''
				this.displayCount = this.pageSize
				this.showBackTop = false
				this.backToTop()
			},
			selectTag(tag : string) {
				this.selectedTag = this.selectedTag == tag ? '' : tag
				this.tagOptionsOpen = false
				this.displayCount = this.pageSize
				this.showBackTop = false
				this.backToTop()
			},
			toggleTagOptions() {
				this.tagOptionsOpen = !this.tagOptionsOpen
			},
			clearTagSelection() {
				this.selectedTag = ''
				this.displayCount = this.pageSize
				this.tagOptionsOpen = false
				this.showBackTop = false
				this.backToTop()
			},
			clearFilters() {
				this.searchKeyword = ''
				this.selectedTag = ''
				this.tagOptionsOpen = false
				this.displayCount = this.pageSize
				this.showBackTop = false
				this.backToTop()
			},
			loadMore() {
				if (this.canLoadMore) {
					this.displayCount = this.displayCount + this.pageSize
				}
			},
			handleScrollToLower() {
				this.loadMore()
			},
			handleScroll(event : any) {
				const top = Number(event.detail.scrollTop || 0)
				this.showBackTop = top > 500
			},
			backToTop() {
				this.scrollTopValue = 1

				setTimeout(() => {
					this.scrollTopValue = 0
				}, 20)
			}
		}
	}
</script>

