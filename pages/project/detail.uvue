<template>
	<view class="page" v-if="project != null">
		<site-menu :profile="site.profile" :sections="site.sections" :activeSectionId="sectionId" />

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="detail-shell">
				<view class="hero-section">
					<view class="hero-media">
						<view class="hero-cover-wrap">
							<image class="hero-cover" :src="project.cover" mode="aspectFit" />
						</view>
					</view>

					<view class="hero-info">
						<view class="detail-header">
							<text class="detail-title">{{ project.title }}</text>
							<view class="status-badge">
								<text class="status-badge-text">{{ project.status }}</text>
							</view>
						</view>

						<tag-list :tags="project.tags" />
						<project-meta :project="project" />
					</view>
				</view>

				<view class="content-section">
					<view class="intro-panel">
						<view class="info-block">
							<text class="panel-title">奇域说明</text>
							<text class="intro-summary">{{ project.intro }}</text>
						</view>

						<view class="info-divider"></view>

						<view class="info-block">
							<text class="panel-title">玩法介绍</text>

							<view class="gameplay-list">
								<view v-for="(item, index) in project.gameplay" :key="index" class="gameplay-item">
									<text class="gameplay-dot">•</text>
									<text class="gameplay-text">{{ item }}</text>
								</view>
							</view>
						</view>
					</view>

					<view class="gallery-panel">
						<project-gallery :images="project.gallery" />
					</view>
				</view>
			</view>
		</scroll-view>
	</view>

	<view class="page" v-else>
		<site-menu :profile="site.profile" :sections="site.sections" activeSectionId="" />

		<view class="content empty-wrap">
			<text class="empty-title">未找到该项目</text>
			<view class="primary-btn" @click="goHome">
				<text class="primary-btn-text">返回首页</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { siteData } from '@/data/site.uts'
	import { getProjectById, getProjectSection } from '@/utils/site.uts'
	import SiteMenu from '@/components/site-menu/site-menu.uvue'
	import ProjectMeta from '@/components/project-meta/project-meta.uvue'
	import ProjectGallery from '@/components/project-gallery/project-gallery.uvue'
	import TagList from '@/components/tag-list/tag-list.uvue'

	export default {
		components: {
			SiteMenu,
			ProjectMeta,
			ProjectGallery,
			TagList
		},
		data() {
			return {
				site: siteData,
				project: null as any,
				sectionId: ''
			}
		},
		onLoad(options) {
			const projectId = options?.projectId || ''
			this.project = getProjectById(projectId)
			const section = getProjectSection(projectId)
			this.sectionId = section ? section.id : ''
		},
		methods: {
			goHome() {
				uni.reLaunch({
					url: '/pages/home/index'
				})
			}
		}
	}
</script>

