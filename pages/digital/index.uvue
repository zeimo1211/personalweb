<template>
	<view class="page">
		<site-sidebar :profile="site.profile" :sections="site.sections" activeSectionId="digital" />

		<scroll-view class="content" scroll-y="true" :scroll-top="scrollTopValue" scroll-with-animation="true"
			lower-threshold="120" @scrolltolower="handleScrollToLower" @scroll="handleScroll">
			<view class="hero-card">
				<text class="hero-subtitle">数码 DIY</text>
				<text class="hero-title">我使用过和关注的数码产品</text>
				<text class="hero-desc">
					这里记录我接触过、使用过，或者持续关注的数码设备与电脑 DIY 硬件。
					它们有的是正在使用的装备，有的是印象深刻的产品，也有的是想继续研究和尝试的方向。
				</text>

				<view class="toolbar">
					<view class="search-box">
						<input class="search-input" :value="searchKeyword" placeholder="搜索名称 / 分类 / 状态 / 核心信息 / 评价"
							@input="onSearchInput" />
					</view>

					<view v-if="searchKeyword != ''" class="clear-btn" @click="clearSearch">
						<text class="clear-btn-text">清空搜索</text>
					</view>

					<view class="result-badge">
						<text class="result-badge-text">共 {{ filteredDigitalItems.length }} 项</text>
					</view>
				</view>
			</view>

			<view v-if="visibleDigitalItems.length > 0" class="digital-list">
				<view v-for="item in visibleDigitalItems" :key="item.id" class="digital-card">
					<view class="digital-cover-wrap">
						<image class="digital-cover" :src="item.cover" mode="aspectFit" />
					</view>

					<view class="digital-main">
						<view class="digital-header">
							<text class="digital-title">{{ item.title }}</text>

							<view class="digital-score-badge">
								<text class="digital-score-text">{{ item.score }}</text>
							</view>
						</view>

						<view class="digital-meta-row">
							<view class="digital-tag">
								<text class="digital-tag-text">{{ item.category }}</text>
							</view>

							<view class="digital-status-tag">
								<text class="digital-status-tag-text">{{ item.status }}</text>
							</view>
						</view>

						<view class="digital-spec-block">
							<text class="digital-spec-label">核心信息</text>
							<text class="digital-spec-text">{{ item.spec }}</text>
						</view>

						<view class="digital-review-block">
							<text class="digital-review-label">评价</text>
							<text class="digital-review-text">{{ item.review }}</text>
						</view>
					</view>
				</view>
			</view>

			<view v-else class="empty-wrap">
				<text class="empty-text">没有找到匹配的数码产品。</text>
			</view>

			<view v-if="canLoadMore" class="load-tip-wrap">
				<text class="load-tip-text">继续下滑以加载更多</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>

		<view v-if="showBackTop" class="back-top-btn" @click="backToTop">
			<text class="back-top-btn-text">回到顶部</text>
		</view>
	</view>
</template>

<script lang="uts">
	import { siteData } from '@/data/site.uts'
	import SiteSidebar from '@/components/site-sidebar/site-sidebar.uvue'

	export default {
		components: {
			SiteSidebar
		},
		data() {
			return {
				site: siteData,
				searchKeyword: '',
				displayCount: 8,
				pageSize: 8,
				scrollTopValue: 0,
				showBackTop: false
			}
		},
		computed: {
			filteredDigitalItems() : any[] {
				const keyword = this.searchKeyword.trim().toLowerCase()
				const list = this.site.digitalDIY as any[]

				if (keyword == '') {
					return list
				}

				return list.filter((item) => {
					const title = String(item.title || '').toLowerCase()
					const category = String(item.category || '').toLowerCase()
					const status = String(item.status || '').toLowerCase()
					const score = String(item.score || '').toLowerCase()
					const spec = String(item.spec || '').toLowerCase()
					const review = String(item.review || '').toLowerCase()

					return (
						title.indexOf(keyword) > -1 ||
						category.indexOf(keyword) > -1 ||
						status.indexOf(keyword) > -1 ||
						score.indexOf(keyword) > -1 ||
						spec.indexOf(keyword) > -1 ||
						review.indexOf(keyword) > -1
					)
				})
			},
			visibleDigitalItems() : any[] {
				return this.filteredDigitalItems.slice(0, this.displayCount)
			},
			canLoadMore() : boolean {
				return this.displayCount < this.filteredDigitalItems.length
			}
		},
		methods: {
			onSearchInput(event : any) {
				this.searchKeyword = String(event.detail.value || '')
				this.displayCount = this.pageSize
			},
			clearSearch() {
				this.searchKeyword = ''
				this.displayCount = this.pageSize
			},
			handleScrollToLower() {
				if (this.canLoadMore) {
					this.displayCount = this.displayCount + this.pageSize
				}
			},
			handleScroll(event : any) {
				const top = Number(event.detail.scrollTop || 0)
				this.showBackTop = top > 500
			},
			backToTop() {
				this.scrollTopValue = 0
			}
		}
	}
</script>

